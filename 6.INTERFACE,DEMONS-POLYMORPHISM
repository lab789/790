// Interface 1
interface Animal {

    void eat();
}

// Interface 2
interface Pet {

    void play();
}

// Dog class implementing both interfaces
class Dog implements Animal, Pet {

    public void eat() {
        System.out.println("Dog eats food");
    }

    public void play() {
        System.out.println("Dog plays with ball");
    }
}

// Main class
public class Main {

    public static void main(String[] args) {

        // Polymorphism using Animal reference
        Animal a = new Dog();
        a.eat();

        // Polymorphism using Pet reference
        Pet p = new Dog();
        p.play();

        // Direct object
        Dog d = new Dog();
        d.eat();
        d.play();
    }
}
